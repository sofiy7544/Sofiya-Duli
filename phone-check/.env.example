# PostgreSQL
DATABASE_URL=postgres://app:app@localhost:5432/phonecheck

# 32-байтовые ключи в base64. Сгенерировать: openssl rand -base64 32
# DATA_ENCRYPTION_KEY — AES-256-GCM для ФИО, телефонов, каналов связи, загруженных файлов.
# BLIND_INDEX_KEY    — HMAC-SHA256 для поиска по телефону без расшифровки.
DATA_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
# Необязательно: старые ключи для ротации, формат "v1:BASE64,v2:BASE64"; текущая версия — DATA_ENCRYPTION_KEY_VERSION
DATA_ENCRYPTION_KEY_VERSION=v1
DATA_ENCRYPTION_KEYS_OLD=

# Страна по умолчанию для номеров без кода страны (ISO 3166-1 alpha-2)
DEFAULT_REGION=UA

# Лимиты и сроки хранения
MAX_UPLOAD_MB=25
MAX_ROWS=200000
UPLOAD_BLOB_TTL_MINUTES=60
RESULT_RETENTION_DAYS=30
SESSION_TTL_HOURS=12

# true за HTTPS-прокси: cookie с флагом Secure
COOKIE_SECURE=false

# docker compose
POSTGRES_USER=phonecheck
POSTGRES_PASSWORD=
POSTGRES_DB=phonecheck
WEB_PORT=3000
