{
  "name": "phone-check",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild src/worker/main.ts src/scripts/migrate.ts src/scripts/seed.ts src/scripts/create-admin.ts src/scripts/import-crm.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --packages=external --alias:@=./src",
    "start": "next start -p 3000",
    "worker": "tsx src/worker/main.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "user:create": "tsx src/scripts/create-admin.ts",
    "crm:import": "tsx src/scripts/import-crm.ts",
    "sample:generate": "tsx src/scripts/generate-samples.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.13",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "pg-boss": "^12.35.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
